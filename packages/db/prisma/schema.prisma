generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityProvider {
  telegram
  email
  google
  apple
}
enum HabitType {
  binary
  counter
  duration
}
enum EntryStatus {
  done
  skip
  miss
}
enum EntrySource {
  web
  tg
  mobile
  widget
}
enum ReminderChannel {
  tg
  push
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  timezone     String
  dayStartHour Int         @default(4)
  locale       String
  createdAt    DateTime    @default(now())
  identities   Identity[]
  habits       Habit[]
  entries      Entry[]
  reminders    Reminder[]
  botSessions  BotSession[]
  entryOperations EntryOperation[]
  deviceSessions DeviceSession[]
  habitOperations HabitOperation[]
  deletedHabits HabitTombstone[]
}

model Identity {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  provider   IdentityProvider
  externalId String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, externalId])
  @@index([userId])
}

model Habit {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  title            String
  icon             String
  color            String
  category         String
  type             HabitType
  targetValue      Decimal?          @db.Decimal(12, 3)
  unit             String?
  sortOrder        Int               @default(0)
  revision         Int               @default(0)
  journalMetadata  Json              @default("{}")
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleVersions ScheduleVersion[]
  entries          Entry[]
  reminders        Reminder[]
  stats            HabitStats?
  entryOperations  EntryOperation[]
  @@index([userId, archivedAt])
}

model HabitOperation {
  userId      String   @db.Uuid
  operationId String  @db.Uuid
  habitId     String  @db.Uuid
  payload     Json
  result      Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, operationId])
  @@index([userId, habitId])
}

model HabitTombstone {
  habitId String @id @db.Uuid
  userId String @db.Uuid
  deletedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model ScheduleVersion {
  id        String   @id @default(uuid()) @db.Uuid
  habitId   String   @db.Uuid
  kind      String
  config    Json
  validFrom DateTime @db.Date
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  @@unique([habitId, validFrom])
}

model Entry {
  id        String      @id @default(uuid()) @db.Uuid
  habitId   String      @db.Uuid
  userId    String      @db.Uuid
  localDate DateTime    @db.Date
  value     Decimal?    @db.Decimal(12, 3)
  status    EntryStatus
  source    EntrySource
  clientId  String      @db.Uuid
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  revision  Int         @default(0)
  resetRevision Int     @default(0)
  deleted   Boolean     @default(false)
  habit     Habit       @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([habitId, localDate])
  @@unique([clientId])
  @@index([userId, localDate])
}

model EntryOperation {
  userId      String   @db.Uuid
  operationId String   @db.Uuid
  habitId     String   @db.Uuid
  localDate   DateTime @db.Date
  sequence    BigInt   @default(autoincrement()) @unique
  payload     Json
  result      Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  @@id([userId, operationId])
  @@index([userId, sequence])
}

model Reminder {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid
  habitId    String?         @db.Uuid
  localTime  DateTime        @db.Time(0)
  daysMask   Int
  channel    ReminderChannel
  enabled    Boolean         @default(true)
  nextFireAt DateTime
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit      Habit?          @relation(fields: [habitId], references: [id], onDelete: Cascade)
  deliveries ReminderDelivery[]
  @@index([userId])
  @@index([enabled, nextFireAt])
}

model ReminderDelivery {
  id String @id @default(uuid()) @db.Uuid
  reminderId String @db.Uuid
  scheduledAt DateTime
  localDate String @db.VarChar(10)
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String? @db.Uuid
  leaseUntil DateTime?
  lastError String?
  completedAt DateTime?
  reminder Reminder @relation(fields:[reminderId],references:[id],onDelete:Cascade)
  @@unique([reminderId,scheduledAt])
  @@index([status,nextAttemptAt,leaseUntil])
}

model BotSession {
  key       String   @id
  userId    String?  @db.Uuid
  data      Json
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model HabitStats {
  habitId        String   @id @db.Uuid
  currentStreak  Int
  bestStreak     Int
  completionRate Float?
  computedAt     DateTime
  habit           Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)
}

model HabitTemplate {
  id              String    @id
  title           String
  icon            String
  category        String
  defaultSchedule Json
  defaultType     HabitType
  locale          String
  @@index([locale, category])
}

model RateLimitWindow {
  key       String   @id
  hits      Int
  expiresAt DateTime
  @@index([expiresAt])
}

model AuthGrant {
  hash         String   @id
  purpose      String
  subject      String
  challenge    String?
  expiresAt    DateTime
  consumedAt   DateTime?
  @@index([expiresAt])
}

model DeviceSession {
  hash       String   @id
  userId     String   @db.Uuid
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model AccountDeletionReceipt {
  sessionHash String @id
  userHash String
  expiresAt DateTime
  @@index([expiresAt])
}

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "TELEGRAM_BOT_TOKEN",
        "TELEGRAM_BOT_USERNAME",
        "BOT_TOKEN",
        "SESSION_SECRET",
        "CROSS_SITE_COOKIES",
        "APP_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "RESEND_API_KEY",
        "MAGIC_LINK_FROM",
        "NODE_ENV"
      ],
      "outputs": ["dist/**", "generated/**", ".next/**", "!.next/cache/**"]
    },
    "test": { "dependsOn": ["build"], "outputs": [] },
    "lint": { "dependsOn": ["^lint"], "outputs": [] },
    "typecheck": { "dependsOn": ["^typecheck", "build"], "outputs": [] },
    "format:check": { "outputs": [] }
  }
}

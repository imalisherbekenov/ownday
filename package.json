{
  "name": "ownday",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eas-build-post-install": "pnpm --filter \"@ownday/mobile^...\" build"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "allowedDeprecatedVersions": {
      "next": "15.5.24",
      "source-map": "0.8.0-beta.0",
      "uuid": "7.0.3",
      "whatwg-encoding": "3.1.1"
    }
  }
}

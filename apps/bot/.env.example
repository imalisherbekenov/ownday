# Telegram bot token. The web app reads the same variable; BOT_TOKEN is still
# accepted as a fallback so existing local .env files keep working.
TELEGRAM_BOT_TOKEN=
BOT_TOKEN=

# PostgreSQL connection used by Prisma (postgresql://user:password@host:port/database).
DATABASE_URL=

# Public origin of the web app (https://...). When set, the bot offers the Mini App
# buttons; when empty, the bot behaves exactly as before.
APP_URL=

# Session cookie settings of the web app, listed for parity with apps/web/.env.example.
# The bot itself does not read them.
SESSION_SECRET=
CROSS_SITE_COOKIES=

WEBHOOK_URL=
NODE_ENV=development
PORT=3000

# Имя бота без @ — от него страница /auth/required строит ссылку в Telegram.
# Не задано — ссылка просто не показывается.
TELEGRAM_BOT_USERNAME=

# PostgreSQL connection used by Prisma. Without it, non-production runs use in-memory demo data.
DATABASE_URL=postgresql://user:password@localhost:5432/habits

# Telegram bot token used to verify Telegram Mini App initData signatures. Telegram auth fails without it.
TELEGRAM_BOT_TOKEN=

# Secret used to sign web session cookies. Set a strong random value in production.
SESSION_SECRET=

# Runtime mode. In production, unauthenticated requests fail instead of loading demo data.
NODE_ENV=development

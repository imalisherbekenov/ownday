# PostgreSQL connection used by Prisma (postgresql://user:password@host:port/database).
# Without it, non-production runs use in-memory demo data.
DATABASE_URL=

# Telegram bot token used to verify Telegram Mini App initData signatures.
# The same secret the bot uses. Telegram auth fails without it.
TELEGRAM_BOT_TOKEN=

# Secret used to sign web session cookies. Set a strong random value in production.
SESSION_SECRET=

# Set to 1 when the app is served inside the Telegram Mini App iframe: cookies then
# go out as SameSite=None; Secure. A deployment decision, deliberately not NODE_ENV.
CROSS_SITE_COOKIES=

# Public origin of the web app (https://...). Used in magic links and by the bot's
# "open the app" buttons.
APP_URL=

# Runtime mode. In production, unauthenticated requests fail instead of loading demo data.
NODE_ENV=development

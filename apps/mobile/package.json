{
  "name": "@ownday/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "native:generate": "expo prebuild --platform all",
    "build": "expo export --platform android --output-dir dist",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "eas-build-post-install": "cd ../.. && pnpm --filter \"@ownday/mobile^...\" build"
  },
  "dependencies": {
    "@expo-google-fonts/hanken-grotesk": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@ownday/core": "workspace:*",
    "@ownday/tokens": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@tanstack/query-async-storage-persister": "^5.90.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-persist-client": "^5.90.2",
    "@trpc/client": "11.5.0",
    "buffer": "6.0.3",
    "expo": "^57.0.22",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "^57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-localization": "^57.0.2",
    "expo-notifications": "^57.0.18",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "^57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.7",
    "tailwindcss": "^3.4.17"
  }
}
